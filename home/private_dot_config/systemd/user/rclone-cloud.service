[Unit]
Description=rclone mount — Microsoft 365 (combine remote)
Documentation=man:rclone(1)

[Service]
Type=notify
ExecStartPre=/usr/bin/mkdir -p %h/cloud
ExecStart=/home/linuxbrew/.linuxbrew/bin/rclone mount cloud: %h/cloud \
    --config %h/.config/rclone/rclone.conf \
    --cache-dir %h/.cache/rclone-cloud \
    --dir-cache-time 1m \
    --vfs-cache-mode writes \
    --vfs-cache-max-size 5G \
    --vfs-cache-max-age 72h \
    --log-level NOTICE
ExecStop=-/usr/bin/fusermount3 -uz %h/cloud
Restart=on-failure
RestartSec=10
TimeoutStopSec=30

[Install]
WantedBy=default.target
