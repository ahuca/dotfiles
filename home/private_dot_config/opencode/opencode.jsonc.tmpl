{{- /*
  Rendered to ~/.config/opencode/opencode.jsonc by chezmoi; API keys come from
  `sync-secrets`. The volatile provider tuning (default model, OpenRouter
  profiles and models) is machine-local in ~/.config/opencode/providers.jsonc,
  seeded from home/.chezmoitemplates/opencode-providers.jsonc; re-seed with
  OPENCODE_RESEED=1 chezmoi apply. This template falls back to the tracked
  default for as long as the local file is missing.
*/ -}}
{{- $dir := includeTemplate "secrets-dir" . -}}
{{- $local := joinPath .chezmoi.homeDir ".config/opencode/providers.jsonc" -}}
{{- $providers := "" -}}
{{- if stat $local -}}
{{-   $providers = include $local | fromJsonc -}}
{{- else -}}
{{-   $providers = include ".chezmoitemplates/opencode-providers.jsonc" | fromJsonc -}}
{{- end -}}
{
  // Managed by chezmoi (home/private_dot_config/opencode/opencode.jsonc.tmpl).
  // Keys come from `sync-secrets`; the provider tuning comes from
  // ~/.config/opencode/providers.jsonc (tracked default as fallback).
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": "notify",
  "model": {{ $providers.model | quote }},
  "small_model": {{ $providers.small_model | quote }},
  "provider": {
{{- range $name, $profile := $providers.profiles }}
    {{ $name | quote }}: {
      "npm": {{ $providers.npm | quote }},
      "options": {
        "apiKey": "{file:{{ $dir }}/{{ $profile.keyFile }}}"
      },
      "models": {
{{-   range $modelID, $model := $providers.models }}
        {{ $modelID | quote }}: {{ $model | toJson }},
{{-   end }}
      }
    },
{{- end }}
  },
  "mcp": {
    "GitHits": {
      "type": "remote",
      "url": "https://mcp.githits.com"
    },
    "atlassian": {
      "type": "local",
      "command": ["uvx", "mcp-atlassian"],
      "enabled": true,
      "environment": {
        "JIRA_URL": "{file:{{ $dir }}/jira.work.url}",
        "JIRA_USERNAME": "{file:{{ $dir }}/jira.work.user}",
        "JIRA_API_TOKEN": "{file:{{ $dir }}/jira.work.key}"
      }
    }
  }
}
