{{- /*
  opencode's machine-local config, in the native V2 shape
  (https://opencode.ai/v2/docs/migrate-v1). The create_ prefix means chezmoi
  creates it only if it does not exist - afterwards the file is yours to edit
  and chezmoi never modifies it (opencode hot-reloads edits; git never sees
  it; the sibling files in the directory stay ignored via .chezmoiignore).
  Reset: delete the file, `chezmoi apply` re-creates it from the tracked
  default tuning in home/.chezmoitemplates/opencode-providers.jsonc,
  wiping local edits. Skipped without a vault (.chezmoiignore), since the
  config refers to keys `sync-secrets` fetches.
*/ -}}
{{- $dir := includeTemplate "secrets-dir" . -}}
{{- $providers := include ".chezmoitemplates/opencode-providers.jsonc" | fromJsonc -}}
{
  // Created by chezmoi on first apply; yours to edit - opencode hot-reloads
  // changes. Reset to the tracked default by deleting this file and running
  // `chezmoi apply` again.
  "$schema": "https://opencode.ai/config.json",
  "update": "notify",
  "model": {{ $providers.model | quote }},
  "agents": {
    "title": {
      "model": {{ $providers.title_model | quote }}
    }
  },
  "providers": {
{{- range $name, $profile := $providers.profiles }}
    {{ $name | quote }}: {
      "package": {{ $providers.package | quote }},
      "settings": {
        "apiKey": "{file:{{ $dir }}/{{ $profile.keyFile }}}"
      },
      "models": {
{{-   range $modelID, $model := $providers.models }}
        {{ $modelID | quote }}: {{ $model | toJson }},
{{-   end }}
      }
    },
{{- end }}
  },
  "mcp": {
    "servers": {
      "GitHits": {
        "type": "remote",
        "url": "https://mcp.githits.com"
      },
      "atlassian": {
        "type": "local",
        "command": ["uvx", "mcp-atlassian"],
        "disabled": false,
        "environment": {
          "JIRA_URL": "{file:{{ $dir }}/jira.work.url}",
          "JIRA_USERNAME": "{file:{{ $dir }}/jira.work.user}",
          "JIRA_API_TOKEN": "{file:{{ $dir }}/jira.work.key}"
        }
      }
    }
  }
}
