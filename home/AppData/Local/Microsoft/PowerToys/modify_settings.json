{{- /* chezmoi:modify-template */ -}}
{{- /* PowerToys rewrites its own settings.json, so chezmoi only switches
       Keyboard Manager on (it ships disabled) and keeps the rest. Takes
       effect when PowerToys next starts. */ -}}
{{- $settings := dict -}}
{{- $in := .chezmoi.stdin | trimPrefix "\ufeff" -}}
{{- if trim $in }}{{ $settings = fromJson $in }}{{ end -}}
{{- /* Untouched copy: when nothing changes, the file is returned as is,
       so PowerToys' own formatting doesn't show up as a diff. */ -}}
{{- $original := dict -}}
{{- if trim $in }}{{ $original = fromJson $in }}{{ end -}}
{{- $settings = setValueAtPath (list "enabled" "Keyboard Manager") true $settings -}}
{{- if deepEqual $original $settings }}{{ .chezmoi.stdin }}{{ else -}}
{{ toPrettyJson "    " $settings }}
{{ end -}}
