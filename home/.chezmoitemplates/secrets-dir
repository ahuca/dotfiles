{{- /* Where sync-secrets puts the keys: tmpfs on Linux; on Windows, which has
       none, an owner-only folder that a logon task empties. */ -}}
{{- if eq .chezmoi.os "windows" -}}
{{-   joinPath (env "LOCALAPPDATA") "dotfiles/secrets" | replace "\\" "/" -}}
{{- else -}}
/run/user/{{ .chezmoi.uid }}/dotfiles/secrets
{{- end -}}
