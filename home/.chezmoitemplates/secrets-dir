{{- /* Where sync-secrets puts the keys: an owner-only folder in the user
       profile, on disk on both platforms (the disk is encrypted). */ -}}
{{- if eq .chezmoi.os "windows" -}}
{{-   joinPath (env "LOCALAPPDATA") "dotfiles/secrets" | replace "\\" "/" -}}
{{- else -}}
{{-   joinPath .chezmoi.homeDir ".local/share/dotfiles/secrets" -}}
{{- end -}}
