#Requires -Version 7
# Managed by chezmoi; change vault.secrets in home/.chezmoidata/vault.yaml.
#   sync-secrets           fetch from Vaultwarden, then smoke-test
#   sync-secrets -Check    smoke-test what is already fetched
# The Windows twin of the Linux script: the Bitwarden CLI (bw) instead of rbw,
# and an owner-only folder in the user profile.
[CmdletBinding()]
param([switch]$Check)

$ErrorActionPreference = 'Stop'
$dir = '{{ includeTemplate "secrets-dir" . }}'
$vaultUrl = '{{ .vault.url }}'
$vaultEmail = '{{ .vault.email }}'
# folder is case-sensitive; field defaults to the password.
$secrets = @(
{{- range .vault.secrets }}
    @{ Dest = '{{ .dest }}'; Folder = '{{ .folder }}'; Item = '{{ .item }}'; Field = '{{ .field | default "" }}' }
{{- end }}
)
$w = ($secrets.Dest | Measure-Object -Property Length -Maximum).Maximum   # output column width
$failed = $false

function Write-Row([string]$Name, [string]$Text) {
    Write-Host ('  {0} {1}' -f $Name.PadRight($w), $Text)
}

# Only this account can open the folder: not other users, not even
# Administrators. Every sync rebuilds it, so a renamed, removed or
# now-failing entry can't leave a stale value behind.
function Reset-SecretsDir {
    New-Item -ItemType Directory -Force -Path $dir | Out-Null
    $sid = [Security.Principal.WindowsIdentity]::GetCurrent().User.Value
    icacls $dir /inheritance:r /grant:r "*${sid}:(OI)(CI)F" | Out-Null
    if ($LASTEXITCODE) { throw "icacls could not restrict $dir" }
    Get-ChildItem -LiteralPath $dir -File -Force | Remove-Item -Force
}

# bw keeps nothing unlocked between runs: the session key lives in this
# process only. The server can only be set while logged out.
function Open-Vault {
    if (-not (Get-Command bw -ErrorAction Ignore)) { throw 'bw (Bitwarden CLI) is not installed' }
    $status = bw status | Out-String | ConvertFrom-Json
    switch ($status.status) {
        'unauthenticated' {
            if ($status.serverUrl -ne $vaultUrl) { bw config server $vaultUrl | Out-Null }
            $env:BW_SESSION = bw login $vaultEmail --raw
        }
        'locked' { $env:BW_SESSION = bw unlock --raw }
    }
    if ($LASTEXITCODE -or -not $env:BW_SESSION) { throw 'could not unlock the vault' }
}

function Get-FieldValue($Item, [string]$Field) {
    switch ($Field) {
        { $_ -in '', 'password' } { return $Item.login.password }
        'username' { return $Item.login.username }
        'notes' { return $Item.notes }
    }
    $custom = @($Item.fields | Where-Object name -EQ $Field)
    if ($custom) { return $custom[0].value }
    if ($Field -in 'url', 'uri' -and $Item.login.uris) { return $Item.login.uris[0].uri }
}

# Same-named items in different folders are told apart by the folder. A
# missing or empty value counts as a failure; failures keep going and fail
# the run at the end.
function Save-Secret($Secret, $Items, $Folders) {
    $src = '{0}/{1}:{2}' -f $Secret.Folder, $Secret.Item, ($Secret.Field ? $Secret.Field : 'password')
    $folderId = ($Folders | Where-Object name -CEQ $Secret.Folder).id
    $found = @($Items | Where-Object { $_.name -ceq $Secret.Item -and $_.folderId -eq $folderId })
    $value = if ($found.Count -eq 1) { Get-FieldValue $found[0] $Secret.Field }
    if (-not $value) {
        $why = if ($found.Count -gt 1) { 'ambiguous' } else { 'empty or not found' }
        Write-Row $Secret.Dest "<- $src  FAILED ($why)"
        $script:failed = $true
        return
    }
    # Through a temp file, so opencode never reads a half-written key.
    $tmp = Join-Path $dir ('.tmp.' + [IO.Path]::GetRandomFileName())
    [IO.File]::WriteAllText($tmp, $value)
    Move-Item -Force -LiteralPath $tmp -Destination (Join-Path $dir $Secret.Dest)
    Write-Row $Secret.Dest "<- $src"
}

# Read-only: GET /myself returns the authenticated user and changes nothing.
function Test-Jira {
    $files = 'jira.work.url', 'jira.work.user', 'jira.work.key' | ForEach-Object { Join-Path $dir $_ }
    if (@($files | Where-Object { -not (Test-Path $_) -or -not (Get-Item $_).Length }).Count) {
        Write-Row jira 'skipped (not fetched)'
        return $true
    }
    $url, $user, $token = $files | ForEach-Object { (Get-Content -Raw $_).Trim() }
    $url = $url.TrimEnd('/')
    $auth = [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes("${user}:$token"))
    try {
        $code = (Invoke-WebRequest -Uri "$url/rest/api/3/myself" -Headers @{ Authorization = "Basic $auth" } `
                -TimeoutSec 15 -SkipHttpErrorCheck -UseBasicParsing).StatusCode
    } catch { $code = 0 }
    switch ($code) {
        200 { Write-Row jira 'OK'; return $true }
        { $_ -in 401, 403 } { Write-Row jira "FAILED ($code): $url rejected $user's token" }
        0 { Write-Row jira "FAILED: could not reach $url" }
        default { Write-Row jira "FAILED (HTTP $code)" }
    }
    return $false
}

if (-not $Check) {
    Open-Vault
    # Pull first to pick up vault changes now. A failure is usually an expired
    # login; carry on with the cached values but fail the run.
    bw sync | Out-Null
    if ($LASTEXITCODE) {
        Write-Host 'bw sync FAILED, using cached values. Offline? Retry later. Login expired? bw logout; sync-secrets'
        $failed = $true
    }
    $items = bw list items | Out-String | ConvertFrom-Json
    $folders = bw list folders | Out-String | ConvertFrom-Json
    Write-Host "Refreshing secrets into $dir"
    Reset-SecretsDir
    foreach ($s in $secrets) { Save-Secret $s $items $folders }
}

Write-Host 'Smoke tests'
if (-not (Test-Jira)) { $failed = $true }
exit [int]$failed
