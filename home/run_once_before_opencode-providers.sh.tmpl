{{- /*
  Bootstrap opencode's config once. Writes both files under the machine-local
  ~/.config/opencode/ (which .chezmoiignore excludes, so chezmoi never diffs
  or overwrites them again):
  - providers.jsonc — a copy of the tracked default
    (home/.chezmoitemplates/opencode-providers.jsonc): the seed, the reset
    source, and the file you promote.
  - opencode.jsonc — the full config: static keys with that default tuning
    rendered in. Afterwards the files are yours to tune freely; opencode
    hot-reloads edits, and git never sees them.
  OPENCODE_RESEED set to a fresh value (e.g. OPENCODE_RESEED=$(date +%s)
  chezmoi apply) re-applies both files from the tracked default, wiping local
  edits — promote a tuning first if you want to keep it. The value must be
  fresh each time: chezmoi skips run_once scripts whose rendered contents it
  has already run, and the variable is baked into the rendered script exactly
  to change them. Like .chezmoiignore's opencode entry, skipped without a
  vault; the ps1 twin covers Windows.
*/ -}}
{{- if and (ne .chezmoi.os "windows") .vault.url .vault.email -}}
#!/bin/sh
# OPENCODE_RESEED={{ env "OPENCODE_RESEED" }}
set -eu
dir="$HOME/.config/opencode"
providers="$dir/providers.jsonc"
config="$dir/opencode.jsonc"
mkdir -p "$dir"
if [ ! -e "$providers" ] || [ -n "${OPENCODE_RESEED:-}" ]; then
    cat >"$providers" <<'JSONC'
{{ include ".chezmoitemplates/opencode-providers.jsonc" -}}
JSONC
fi
if [ ! -e "$config" ] || [ -n "${OPENCODE_RESEED:-}" ]; then
    cat >"$config" <<'JSONC'
{{ $dir := includeTemplate "secrets-dir" . }}{{ $providers := include ".chezmoitemplates/opencode-providers.jsonc" | fromJsonc -}}
{
  // Bootstrapped once by chezmoi's opencode seed script; yours to tune
  // afterwards (opencode hot-reloads edits). Re-apply both files from the
  // tracked default with OPENCODE_RESEED set to a fresh value - see README.
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": "notify",
  "model": {{ $providers.model | quote }},
  "small_model": {{ $providers.small_model | quote }},
  "provider": {
{{- range $name, $profile := $providers.profiles }}
    {{ $name | quote }}: {
      "npm": {{ $providers.npm | quote }},
      "options": {
        "apiKey": "{file:{{ $dir }}/{{ $profile.keyFile }}}"
      },
      "models": {
{{-   range $modelID, $model := $providers.models }}
        {{ $modelID | quote }}: {{ $model | toJson }},
{{-   end }}
      }
    },
{{- end }}
  },
  "mcp": {
    "GitHits": {
      "type": "remote",
      "url": "https://mcp.githits.com"
    },
    "atlassian": {
      "type": "local",
      "command": ["uvx", "mcp-atlassian"],
      "enabled": true,
      "environment": {
        "JIRA_URL": "{file:{{ $dir }}/jira.work.url}",
        "JIRA_USERNAME": "{file:{{ $dir }}/jira.work.user}",
        "JIRA_API_TOKEN": "{file:{{ $dir }}/jira.work.key}"
      }
    }
  }
}
JSONC
fi
{{- end -}}
