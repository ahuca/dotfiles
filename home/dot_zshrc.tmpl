# Managed by chezmoi (home/dot_zshrc.tmpl in the dotfiles repo). Ansible
# installs oh-my-zsh and the plugins it doesn't bundle; this only loads them.
# Machine-only additions go in ~/.zshrc.local.

export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"

# fzf-tab must come after the completion plugins, zsh-syntax-highlighting last.
plugins=(git z fzf fzf-tab zsh-autosuggestions zsh-syntax-highlighting)

source $ZSH/oh-my-zsh.sh

# Grey suggestion from history (→ accepts), else from completion.
ZSH_AUTOSUGGEST_STRATEGY=(history completion)

[ -x /home/linuxbrew/.linuxbrew/bin/brew ] && eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"

# Node from fnm (brew); switches on cd into a dir with .nvmrc/.node-version.
command -v fnm >/dev/null && eval "$(fnm env --use-on-cd --shell zsh)"

# What `pnpm setup` would append here; pnpm refuses global commands
# (`pnpm root -g`, topgrade's pnpm step) while its global bin isn't on PATH.
export PNPM_HOME="$HOME/.local/share/pnpm"
export PATH="$PNPM_HOME/bin:$PATH"

# Every SSH key lives in Bitwarden's agent.
export SSH_AUTH_SOCK="{{ .vault.sshAgentSocket | replace "~" "$HOME" }}"

# zsh never reads ~/.profile, which is where Ubuntu puts ~/.local/bin on PATH
# (pipx's ansible, sync-secrets).
export PATH="$HOME/.local/bin:$PATH"

[ -r ~/.zshrc.local ] && source ~/.zshrc.local
