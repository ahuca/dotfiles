{{- if and (eq .chezmoi.os "linux") .vault.rbw.syncOnLogin .vault.url .vault.email -}}
#!/bin/sh
# Run sync-secrets when the desktop session starts (vault.rbw.syncOnLogin).
# unit hash: {{ include "private_dot_config/systemd/user/sync-secrets.service" | sha256sum }}
set -e
systemctl --user daemon-reload
systemctl --user enable sync-secrets.service
{{ end -}}
