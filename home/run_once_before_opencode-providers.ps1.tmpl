{{- /*
  The Windows twin of run_once_before_opencode-providers.sh.tmpl, which
  documents the behaviour. Rendered empty on other platforms; pwsh writes
  UTF-8 without a BOM.
*/ -}}
{{- if and (eq .chezmoi.os "windows") .vault.url .vault.email -}}
# OPENCODE_RESEED={{ env "OPENCODE_RESEED" }}
$ErrorActionPreference = 'Stop'
# Bootstraps ~/.config/opencode/ once: providers.jsonc (a copy of the tracked
# default) and opencode.jsonc (the full config, default tuning rendered in).
# The directory is machine-local after that (.chezmoiignore excludes it);
# set $env:OPENCODE_RESEED to a fresh value (e.g. (Get-Date).Ticks) to
# re-apply both files from the tracked default, wiping local edits. The value
# must differ from the last reseed's: chezmoi skips run_once scripts whose
# rendered contents it has already run, and the value is baked into the
# rendered script exactly to change them.
$dir = Join-Path $HOME '.config/opencode'
$providers = Join-Path $dir 'providers.jsonc'
$config = Join-Path $dir 'opencode.jsonc'
New-Item -ItemType Directory -Force -Path $dir | Out-Null
if ((-not (Test-Path $providers)) -or $env:OPENCODE_RESEED) {
    @'
{{ include ".chezmoitemplates/opencode-providers.jsonc" -}}
'@ | Set-Content -Path $providers -Encoding utf8
}
if ((-not (Test-Path $config)) -or $env:OPENCODE_RESEED) {
    @'
{{ $dir := includeTemplate "secrets-dir" . }}{{ $providers := include ".chezmoitemplates/opencode-providers.jsonc" | fromJsonc -}}
{
  // Bootstrapped once by chezmoi's opencode seed script; yours to tune
  // afterwards (opencode hot-reloads edits). Re-apply both files from the
  // tracked default with OPENCODE_RESEED set to a fresh value - see README.
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": "notify",
  "model": {{ $providers.model | quote }},
  "small_model": {{ $providers.small_model | quote }},
  "provider": {
{{- range $name, $profile := $providers.profiles }}
    {{ $name | quote }}: {
      "npm": {{ $providers.npm | quote }},
      "options": {
        "apiKey": "{file:{{ $dir }}/{{ $profile.keyFile }}}"
      },
      "models": {
{{-   range $modelID, $model := $providers.models }}
        {{ $modelID | quote }}: {{ $model | toJson }},
{{-   end }}
      }
    },
{{- end }}
  },
  "mcp": {
    "GitHits": {
      "type": "remote",
      "url": "https://mcp.githits.com"
    },
    "atlassian": {
      "type": "local",
      "command": ["uvx", "mcp-atlassian"],
      "enabled": true,
      "environment": {
        "JIRA_URL": "{file:{{ $dir }}/jira.work.url}",
        "JIRA_USERNAME": "{file:{{ $dir }}/jira.work.user}",
        "JIRA_API_TOKEN": "{file:{{ $dir }}/jira.work.key}"
      }
    }
  }
}
'@ | Set-Content -Path $config -Encoding utf8
}
{{- end -}}
