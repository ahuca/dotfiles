# yaml-language-server: $schema=https://aka.ms/configuration-dsc-schema/0.2
# The Windows counterpart of linux/: everything machine-wide. Dotfiles come
# afterwards from chezmoi (home/). Run by bootstrap.ps1, or on its own:
#   winget configure -f windows\configuration.winget
# Add a package: copy one WinGetPackage entry and change id/settings.id
# (find ids with `winget search <name>`).
properties:
  configurationVersion: 0.2.0
  resources:
    # ── shell and terminal ─────────────────────────────────────────
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: powershell
      directives: { description: PowerShell 7, allowPrerelease: true }
      settings: { id: Microsoft.PowerShell, source: winget }
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: terminal
      directives: { description: Windows Terminal, allowPrerelease: true }
      settings: { id: Microsoft.WindowsTerminal, source: winget }
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: ohmyposh
      directives: { description: Oh My Posh prompt, allowPrerelease: true }
      settings: { id: JanDeDobbeleer.OhMyPosh, source: winget }

    # ── dotfiles and secrets ───────────────────────────────────────
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: chezmoi
      directives: { description: chezmoi, applies home/, allowPrerelease: true }
      settings: { id: twpayne.chezmoi, source: winget }
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: bitwarden
      directives: { description: Bitwarden, whose SSH agent holds every key, allowPrerelease: true }
      settings: { id: Bitwarden.Bitwarden, source: winget }
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: bitwardencli
      directives: { description: Bitwarden CLI for sync-secrets, allowPrerelease: true }
      settings: { id: Bitwarden.CLI, source: winget }

    # ── dev tools ──────────────────────────────────────────────────
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: git
      directives: { description: Git for Windows (Claude Code's Bash tool uses its bash), allowPrerelease: true }
      settings: { id: Git.Git, source: winget }
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: gh
      directives: { description: GitHub CLI, allowPrerelease: true }
      settings: { id: GitHub.cli, source: winget }
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: delta
      directives: { description: delta, git's and lazygit's pager, allowPrerelease: true }
      settings: { id: dandavison.delta, source: winget }
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: lazygit
      directives: { description: lazygit, allowPrerelease: true }
      settings: { id: JesseDuffield.lazygit, source: winget }
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: ripgrep
      directives: { description: ripgrep, allowPrerelease: true }
      settings: { id: BurntSushi.ripgrep.MSVC, source: winget }
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: fzf
      directives: { description: fzf, allowPrerelease: true }
      settings: { id: junegunn.fzf, source: winget }
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: neovim
      directives: { description: Neovim, allowPrerelease: true }
      settings: { id: Neovim.Neovim, source: winget }
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: glow
      directives: { description: glow, Markdown in the terminal, allowPrerelease: true }
      settings: { id: charmbracelet.glow, source: winget }
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: tealdeer
      directives: { description: tealdeer, the tldr command, allowPrerelease: true }
      settings: { id: dbrgn.tealdeer, source: winget }
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: 7zip
      directives: { description: 7-Zip, allowPrerelease: true }
      settings: { id: 7zip.7zip, source: winget }
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: topgrade
      directives: { description: topgrade, upgrades everything (winget included), allowPrerelease: true }
      settings: { id: topgrade-rs.topgrade, source: winget }
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: node
      directives: { description: Node.js LTS, allowPrerelease: true }
      settings: { id: OpenJS.NodeJS.LTS, source: winget }
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: vscode
      directives: { description: VS Code, allowPrerelease: true }
      settings: { id: Microsoft.VisualStudioCode, source: winget }
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: claudecode
      directives: { description: Claude Code, allowPrerelease: true }
      settings: { id: Anthropic.ClaudeCode, source: winget }
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: opencode
      directives: { description: opencode, allowPrerelease: true }
      settings: { id: SST.opencode, source: winget }
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: uv
      directives: { description: uv (opencode's Atlassian MCP runs under uvx), allowPrerelease: true }
      settings: { id: astral-sh.uv, source: winget }

    # ── desktop ────────────────────────────────────────────────────
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: ditto
      directives: { description: Ditto clipboard manager, allowPrerelease: true }
      settings: { id: Ditto.Ditto, source: winget }
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: onlyoffice
      directives: { description: ONLYOFFICE Desktop Editors, allowPrerelease: true }
      settings: { id: ONLYOFFICE.DesktopEditors, source: winget }
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: everything
      directives: { description: Everything file search, allowPrerelease: true }
      settings: { id: voidtools.Everything, source: winget }

    # ── machine-wide settings (one UAC prompt; winget 1.10.280 or later) ──
    # Bitwarden's SSH agent listens on OpenSSH's own pipe
    # (\\.\pipe\openssh-ssh-agent), so Windows' agent service must stay off.
    - resource: PSDscResources/Service
      id: sshagent
      directives: { description: Leave the OpenSSH agent pipe to Bitwarden, securityContext: elevated, allowPrerelease: true }
      settings:
        Name: ssh-agent
        StartupType: Disabled
        State: Stopped
    # sync-secrets keeps API keys in %LOCALAPPDATA%\dotfiles\secrets. Windows
    # has no tmpfs, so SYSTEM empties it at each logon. The folder is only
    # readable by you and SYSTEM; SYSTEM runs out of sight, in session 0.
    - resource: PSDscResources/Script
      id: secretswipe
      directives: { description: Empty the secrets folder at logon, securityContext: elevated, allowPrerelease: true }
      settings:
        GetScript: |
          @{ Result = [string](Get-ScheduledTask -TaskName 'dotfiles-wipe-secrets' -ErrorAction SilentlyContinue).State }
        TestScript: |
          $task = Get-ScheduledTask -TaskName 'dotfiles-wipe-secrets' -ErrorAction SilentlyContinue
          [bool]$task -and $task.Actions[0].Arguments -like "*$env:LOCALAPPDATA\dotfiles\secrets*"
        SetScript: |
          $dir = Join-Path $env:LOCALAPPDATA 'dotfiles\secrets'
          $action = New-ScheduledTaskAction -Execute 'cmd.exe' -Argument "/d /c if exist `"$dir`" rd /s /q `"$dir`""
          $trigger = New-ScheduledTaskTrigger -AtLogOn -User "$env:USERDOMAIN\$env:USERNAME"
          $principal = New-ScheduledTaskPrincipal -UserId 'S-1-5-18' -LogonType ServiceAccount
          Register-ScheduledTask -TaskName 'dotfiles-wipe-secrets' -Description 'Empties the API keys sync-secrets fetched (dotfiles repo).' `
            -Action $action -Trigger $trigger -Principal $principal -Force | Out-Null
