# {{ ansible_managed }}
[user]
	email = {{ item.email }}
{% if item.owner and item.key and git_profiles_ssh | bool %}
# Shares its host with other repos, so ~/.ssh/config can't route it, and
# skipping it is the only way to stop ssh offering the host's key first: ssh
# offers agent keys in the agent's order, not the -i order.
[core]
	sshCommand = ssh -F none -o IdentitiesOnly=yes{% if bitwarden_ssh_agent_enabled | bool %} -o IdentityAgent={{ bitwarden_ssh_agent_sock | replace('$HOME', '~') }}{% endif %} -i {{ git_ssh_key_dir }}/{{ item.name }}.pub
{% endif %}
