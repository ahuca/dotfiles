#!/usr/bin/env bash
# Managed by Ansible (roles/secrets); change opencode_secrets instead.
#   sync-secrets           fetch from Vaultwarden, then smoke-test
#   sync-secrets --check   smoke-test what is already fetched

set -euo pipefail
umask 077

dir={{ opencode_secrets_dir | quote }}
w={{ opencode_secrets | map(attribute='dest') | map('length') | max }}   # output column width

mode="${1:-sync}"
case "$mode" in
  sync|--check) ;;
  *) echo "usage: sync-secrets [--check]" >&2; exit 2 ;;
esac

mkdir -p "$dir"
chmod 700 "$dir"

# Writes go through a temp file so opencode never reads a half-written key.
trap 'rm -f "$dir"/.tmp.*' EXIT

# Every sync rebuilds the dir from scratch: a renamed, removed or now-failing
# entry can't leave a stale value behind. Refuses an obviously wrong dir.
clear_dir() {
  case "$dir" in
    ""|/|"$HOME"|"$HOME"/) echo "sync-secrets: refusing to clear '$dir'" >&2; exit 2 ;;
  esac
  find "$dir" -mindepth 1 -maxdepth 1 -type f -delete
}

# Without --folder, same-named items in different folders are ambiguous.
# rbw exits 0 with no output for a missing password or field, so an empty
# result counts as a failure too. Failures keep going and fail the run at the end.
failed=0
fetch() {                       # fetch <dest> <folder> <item> [field]
  local dest="$1" folder="$2" item="$3" field="${4:-}" tmp src
  src="$folder/$item:${field:-password}"
  tmp="$(mktemp "$dir/.tmp.XXXXXX")"
  if ! rbw get --folder "$folder" "$item" ${field:+--field="$field"} > "$tmp" \
     || [[ ! -s "$tmp" ]]; then
    rm -f "$tmp"
    printf '  %-*s <- %s  FAILED (empty or not found)\n' "$w" "$dest" "$src"
    failed=1
    return 0
  fi
  mv -f "$tmp" "$dir/$dest"
  printf '  %-*s <- %s\n' "$w" "$dest" "$src"
}

# Read-only: GET /myself returns the authenticated user and changes nothing.
# Credentials go to curl as a config on stdin, so the token never hits argv/ps.
check_jira() {
  local jira_url user token code
  if [[ ! -s "$dir/jira.work.url" || ! -s "$dir/jira.work.user" || ! -s "$dir/jira.work.key" ]]; then
    printf '  %-*s %s\n' "$w" jira "skipped (not fetched)"
    return 0
  fi
  jira_url="$(<"$dir/jira.work.url")"
  jira_url="${jira_url%/}"
  user="$(<"$dir/jira.work.user")"
  token="$(<"$dir/jira.work.key")"
  code="$(curl -sS --max-time 15 -o /dev/null -w '%{http_code}' -K - \
            "$jira_url/rest/api/3/myself" <<<"user = \"$user:$token\"")" || code=000
  case "$code" in
    200)     printf '  %-*s %s\n' "$w" jira "OK" ;;
    401|403) printf '  %-*s %s\n' "$w" jira "FAILED ($code): $jira_url rejected $user's token"; return 1 ;;
    000)     printf '  %-*s %s\n' "$w" jira "FAILED: could not reach $jira_url"; return 1 ;;
    *)       printf '  %-*s %s\n' "$w" jira "FAILED (HTTP $code)"; return 1 ;;
  esac
}

if [[ "$mode" == sync ]]; then
  # rbw get reads the local cache, so pull first to pick up vault changes now
  # rather than at the agent's next hourly sync. A failure here is usually the
  # 30-day login expiring, which the agent otherwise only logs; carry on with
  # the cached values (still better than nothing offline) but fail the run.
  if ! err="$(rbw sync 2>&1)"; then
    printf 'rbw sync FAILED, using cached values: %s\n' "${err##*$'\n'}"
    printf '  offline? retry later. login expired? rbw logout && rbw login\n'
    failed=1
  fi
  printf 'Refreshing secrets into %s\n' "$dir"
  clear_dir
{% for s in opencode_secrets %}
  fetch {{ s.dest | quote }} {{ s.folder | default(rbw_folder) | quote }} {{ s.item | quote }}{% if s.field is defined %} {{ s.field | quote }}{% endif %}

{% endfor %}
fi

printf 'Smoke tests\n'
check_jira || failed=1
exit "$failed"
