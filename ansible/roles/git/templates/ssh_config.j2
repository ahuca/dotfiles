# Each host offers only its profile's Bitwarden key, so the right account
# authenticates even when several share one HostName. Owner-scoped profiles
# pick their key through core.sshCommand instead.
{% for profile in _git_active | selectattr('key') | rejectattr('owner') %}

Host {{ profile.host }}
    HostName {{ profile.hostname }}
    User git
{% if bitwarden_ssh_agent_enabled | bool %}
    IdentityAgent {{ bitwarden_ssh_agent_sock | replace('$HOME', '~') }}
{% endif %}
    IdentityFile {{ git_ssh_key_dir }}/{{ profile.name }}.pub
    IdentitiesOnly yes
{% endfor %}
